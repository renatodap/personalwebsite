// renatodap.me - a cyanotype plate book of one person in motion.
//
// The unit is the frame, and the order of frames IS the argument, so order is
// data rather than markup. The old schema modelled a bill of materials (itemNo,
// qty, material, isAnchor); that world was retired on 2026-07-26 and so are its
// tables. See DESIGN.md for the world contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single row (id = "main"). The literal facts, and nothing else.
///
/// These exist because 57% of viewing time never leaves the first screen: a
/// visitor who leaves in five seconds still has to leave knowing who this is.
model SiteSetting {
  id String @id @default("main")

  subjectName     String @default("Renato Prado")
  subjectRole     String @default("Lead software engineer")
  subjectLocation String @default("Indianapolis")

  email       String @default("")
  githubUrl   String @default("")
  linkedinUrl String @default("")
  youtubeUrl  String @default("")
  spotifyUrl  String @default("")

  updatedAt DateTime @updatedAt
}

/// How a frame is composed. Not derivable from plate count: a two-plate RUN
/// (serve, tennis) and a two-plate PAIR (the wear frame) are different
/// components with different scale, snapping and caption rules.
enum FrameKind {
  /// One drawing, full viewport height, caption set in the left margin. Snaps.
  PLATE

  /// Two to four drawings sized by column width, ~78dvh. Reads as the quiet
  /// between the big pictures, so it deliberately does not snap.
  RUN

  /// Two drawings at equal weight, no caption. Reserved for the wear frame,
  /// which is the emotional peak of the page. Snaps.
  PAIR
}

/// One frame of the sequence.
model Frame {
  id   String    @id @default(cuid())
  kind FrameKind @default(PLATE)

  /// Empty is normal and expected: eight of the twelve frames carry no words.
  /// A newline separates lines; second and later lines render at --ink-70.
  /// Never captions a childhood plate - the adjacency is the statement, and a
  /// caption would say the thing the structure is there to imply.
  caption String @default("") @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  plates Plate[]

  @@index([isActive, sortOrder])
}

/// One drawing inside a frame.
model Plate {
  id      String @id @default(cuid())
  frameId String
  frame   Frame  @relation(fields: [frameId], references: [id], onDelete: Cascade)

  /// Slug only. Resolves to /drawings/detail-<drawing>.svg
  ///
  /// Carries no size or zoom field on purpose. Figure size is normalised in the
  /// ASSET, by trimming each viewBox to its own artwork, so the renderer only
  /// ever needs `mask-size: contain` and can never crop a drawing.
  drawing String

  /// Accessible name, required. A mask-rendered drawing is a background, so the
  /// SVG's own <title> is never exposed to assistive technology.
  alt String @default("")

  sortOrder Int @default(0)

  @@index([frameId, sortOrder])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
